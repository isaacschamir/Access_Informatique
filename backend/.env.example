# ============================================================
# Access Informatique — Configuration backend
# ============================================================
# 1. Copier ce fichier :
#      copy backend\.env.example backend\.env
# 2. Remplir la section MAIL (voir backend/MAIL_SETUP.md)
# 3. Tester :
#      php backend/scripts/test_mail.php
# ============================================================

APP_ENV=development
APP_URL=http://localhost/Access_Informatique/backend

DB_HOST=127.0.0.1
DB_NAME=access_informatique
DB_USER=root
DB_PASS=

JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_STRING_64_CHARS
# Exemple pour générer : openssl rand -hex 32 (sur Linux/macOS)
# Sur Windows PowerShell : [System.BitConverter]::ToString((New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes(32)).Replace('-', '').ToLower()
JWT_EXPIRY=3600

# ── PHPMailer / SMTP ─────────────────────────────────────────
# MAIL_ADMIN = boîte qui reçoit les messages des formulaires (contact, inscription)

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls

# Compte SMTP (ex. votre adresse Gmail)
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=mot_de_passe_application_16_caracteres

# Expéditeur affiché (souvent = même adresse que MAIL_USERNAME pour Gmail)
MAIL_FROM=votre.email@gmail.com
MAIL_FROM_NAME=Access Informatique

# Destinataire des notifications formulaires
MAIL_ADMIN=votre.email@gmail.com

# 1 = logs SMTP détaillés dans les logs PHP (développement uniquement)
MAIL_DEBUG=0

FRONTEND_URL=http://localhost:5173
UPLOAD_URL=http://localhost/Access_Informatique/backend/uploads
